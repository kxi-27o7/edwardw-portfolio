# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skills
.agents

# Local model weights are not public assets and should not be committed.
/local-assets/models/*
!/local-assets/models/*/
/local-assets/models/*/**
!/local-assets/models/*/README.md
!/local-assets/models/*/.gitkeep
!/local-assets/models/seeflood/seeflood_01.pth
!/local-assets/models/fakeguard/config.json
!/local-assets/models/fakeguard/tokenizer.json
!/local-assets/models/fakeguard/tokenizer_config.json
!/local-assets/models/fakeguard/model.safetensors
!/local-assets/models/bankguard/model_maxdepth10.pkl
